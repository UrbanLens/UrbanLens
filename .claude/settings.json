{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 -m pytest:*)",
      "Bash(python3 -m ruff:*)",
      "Bash(python3 -m mypy:*)",
      "Bash(python3 src/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch *)",
      "Bash(git commit *)",
      "Bash(git ls-tree *)",
      "Bash(gh run watch *)",
      "Bash(uv run mypy src)",
      "Bash(uv run mypy src/urbanlens)",
      "Bash(flutter analyze)",
      "Bash(flutter analyze *)",
      "Bash(bun run typecheck)",
      "Bash(bun run check)",
      "Bash(bun run test:ts)",
      "Bash(shellcheck *)",
      "Bash(kubectl logs *)",
      "Bash(docker stats --no-stream)",
      "Bash(docker stats --no-stream *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit -p *)",
      "Bash(git check-ignore *)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(kubectl describe *)",
      "Bash(docker compose ls)",
      "Bash(kubectl get *)",
      "Bash(k3s kubectl get *)",
      "Bash(ip route get *)",
      "Bash(bun run codeql:gate)",
      "Bash(docker top *)",
      "Bash(openssl x509 -noout *)",
      "mcp__plugin_cloudflare_cloudflare-docs__search_cloudflare_documentation",
      "Bash(ruff check --fix)",
      "Bash(dart format)"
    ]
  }
}
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect_files.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format_python.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
