# Copy to `.env` (which is gitignored) and fill in.
# A real environment variable always wins over a value here.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The deployment under test. Never production: the suite creates, edits and
# deletes rows as a real account.
UL_E2E_BASE_URL=https://s1.dev.urbanlens.org

# ---------------------------------------------------------------------------
# Accounts - use ONE of the two blocks below
# ---------------------------------------------------------------------------

# Preferred. Written on the target deployment by:
#   python src/urbanlens/manage.py provision_integration_env --out /tmp/e2e.json
# It carries plaintext passwords and API keys, so keep it out of shared paths.
UL_E2E_ACCOUNTS_FILE=/tmp/e2e.json

# Or, for a one-off run against an account that already exists. The suite needs
# an API key for the `api` project and a password for everything that signs in.
#UL_E2E_USERNAME=e2e-primary
#UL_E2E_PASSWORD=
#UL_E2E_API_KEY=ulk_...
#UL_E2E_SCOPES=profile:read,pins:read,pins:write
#UL_E2E_RESTRICTED_API_KEY=ulk_...
#UL_E2E_RESTRICTED_SCOPES=profile:read
# A second account unlocks the specs about what one user can see of another.
#UL_E2E_SECONDARY_USERNAME=e2e-secondary
#UL_E2E_SECONDARY_PASSWORD=
#UL_E2E_SECONDARY_API_KEY=ulk_...

# ---------------------------------------------------------------------------
# Target characteristics
# ---------------------------------------------------------------------------

# A staging box with its own certificate authority.
#UL_E2E_IGNORE_HTTPS_ERRORS=1

# Set to 0 when pointing at a site whose database is a read-only replica. Every
# write the suite performs will fail there, and only the read-only projects are
# meaningful.
#UL_E2E_EXPECT_PRIMARY=1

# Enables the REData reachability check.
#UL_E2E_REDATA_URL=https://redata.urbanlens.org

# Hostnames the suite refuses to run against. Exact matches, comma separated.
# The default already covers the production hostnames.
#UL_E2E_PRODUCTION_HOSTS=urbanlens.org,www.urbanlens.org,app.urbanlens.org
#UL_E2E_ALLOW_PRODUCTION=0

# bin/run_nuclei_scan.sh reads UL_E2E_BASE_URL as a fallback for its own
# --url, so this file covers both. Its production guard is separate
# (UL_NUCLEI_PRODUCTION_HOSTS / UL_NUCLEI_ALLOW_PRODUCTION), same defaults.

# ---------------------------------------------------------------------------
# Run tuning
# ---------------------------------------------------------------------------

#UL_E2E_WORKERS=4
#UL_E2E_RETRIES=1
#UL_E2E_TIMEOUT_MS=60000
#UL_E2E_EXPECT_TIMEOUT_MS=10000

# Stamped into every record the suite creates, so leftovers are traceable.
# Defaults to a timestamp.
#UL_E2E_RUN_ID=

# Fail a UI test on any console error or failed subresource. On by default.
#UL_E2E_STRICT_CONSOLE=1

# Watch a spec happen, for debugging one failure.
#UL_E2E_HEADED=1
#UL_E2E_SLOW_MO_MS=250

# ---------------------------------------------------------------------------
# Opt-in projects and slow checks
# ---------------------------------------------------------------------------

# Registers the firefox, webkit and mobile UI projects.
#UL_E2E_CROSS_BROWSER=1

# Registers the screenshot-comparison project.
#UL_E2E_VISUAL=1

# Seconds to hold a quiet WebSocket open, to prove the keep-alive survives the
# proxy's idle timeout. 0 skips it; 120 is the smallest useful value.
#UL_E2E_WS_IDLE_SECONDS=0

# How long a Celery worker gets to finish a data export.
#UL_E2E_EXPORT_TIMEOUT_MS=150000

# Registers the live location-data project (specs/location/), which exercises
# one real place - Hudson River State Hospital - end to end through the parcel,
# building, wiki, media and property-record pipelines.
#
# Off by default for two reasons, both worth understanding before turning it on:
#
#  1. It waits minutes on background enrichment, so a full pass is tens of
#     minutes rather than seconds.
#  2. It causes REAL, BILLABLE third-party calls - REData (and through it county
#     GIS and NY SHPO's CRIS), EPA ECHO, Wikipedia, imagery providers.
#
# The account must also be provisioned with --external-apis, or every one of
# these specs is a no-op:
#
#   python src/urbanlens/manage.py provision_integration_env --external-apis --out /tmp/e2e.json
#
#UL_E2E_LOCATION_DATA=1
