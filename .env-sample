# Configure your environment variables in this file

# ---------------------------------------------------------------------------
# Secrets (set both before first run - see docs/DATA_ENCRYPTION.md)
# ---------------------------------------------------------------------------

# Signs sessions, CSRF tokens, and password-reset links. REQUIRED in every
# deployed environment: staging/production refuse to start without it, and
# leaving it unset elsewhere generates a fresh random key in every process, so
# sessions break between workers and anything written to an encrypted field
# becomes permanently unreadable. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Encrypts sensitive database columns (OAuth tokens, TOTP seeds, contact
# details, private notes) at rest. Keep it INDEPENDENT of DJANGO_SECRET_KEY:
# when unset, the encryption key is derived from DJANGO_SECRET_KEY instead,
# which means rotating the signing key after a cookie-forgery incident also
# silently orphans every encrypted row. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# NEVER change this value in place - follow the rotation procedure in
# docs/DATA_ENCRYPTION.md (add new key -> rotate_field_encryption -> drop old).
UL_FIELD_ENCRYPTION_KEY=

# Retired encryption keys, comma-separated. Values are always written under the
# active key above but stay readable under anything listed here, which is what
# makes a key change a rolling change instead of data loss. Populated only
# during a rotation; emptied once `manage.py rotate_field_encryption` completes.
#UL_FIELD_ENCRYPTION_KEY_FALLBACKS=

# Site environment: local | development | staging | testing | production
# local     - developer's own machine (debug on, HTTP allowed, wildcard ALLOWED_HOSTS)
# development - shared dev server (debug on, HTTP allowed)
# staging   - pre-prod server (debug off, HTTPS required)
# production - live site (debug off, HTTPS required)
UL_ENVIRONMENT=production

# Allows running multiple instances of the same environment on the same machine.
UL_CONTAINER_NAME=production

# When false (default for non-local environments), the app redirects plain HTTP requests to
# HTTPS. For local/development environments this defaults to true automatically, so you only
# need to set it explicitly if you want to override that default (e.g. force HTTPS locally).
#UL_UNSAFE_ALLOW_HTTP=False
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# How many reverse proxies sit in front of the app, each appending to X-Forwarded-For.
# Per-IP rate limiting reads that many entries from the right of the chain; anything
# further left came from the client and can be forged. 1 matches the bundled nginx.
# Set 0 only when nothing fronts the app - behind a proxy it would key every request
# to the proxy's own address, letting one attacker throttle everybody.
#UL_TRUSTED_PROXY_COUNT=1

# Public demo instance (see docs/DEMO.md). Set at most one side per deployment:
# UL_DEMO_URL on the real site (empty hides the "Try the demo" button); the
# other three only on the demo deployment itself, which must be a separate
# database from any instance holding real data.
#UL_DEMO_URL=
#UL_DEMO_MODE=False
#UL_DEMO_REAL_SITE_URL=
#UL_DEMO_LOCATIONS_FILE=/app/demo-locations.json

# Base URL used to build absolute links in emails/notifications (e.g. safety check-in
# reminders). Must match the public URL of this environment, including scheme - defaults to
# http://localhost:21080 if unset, which is only correct for local dev. REQUIRED for every
# deployed environment (staging/production) - a missing value here means safety-alert and
# account emails will link back to localhost instead of your real domain.
UL_SITE_URL=https://your-domain.example.com

# Comma-separated list of hostnames Django is allowed to serve (sets ALLOWED_HOSTS).
# Leave blank to use the default: urbanlens.org, localhost, 127.0.0.1
# (localhost/127.0.0.1 are required for Docker's internal /health/ curl probes.)
# Example for a custom staging domain:
#   UL_ALLOWED_HOSTS=staging.urbanlens.org,localhost,127.0.0.1
#UL_ALLOWED_HOSTS=

# --- Media origin -----------------------------------------------------------
# Uploads are served from their own hostname so that anything slipping past
# validation executes in an origin with no session cookie and no app data.
# See docs/MEDIA_PIPELINE.md.
#
# Order matters: bring up media-nginx, point your reverse proxy at
# UL_MEDIA_PORT, confirm the hostname resolves, and only THEN set
# UL_MEDIA_BASE_URL - it rewrites every media URL on the site the moment it is
# set, so a hostname that does not answer yet means every image 404s.
# The media host must also appear in UL_ALLOWED_HOSTS above.
#UL_MEDIA_PORT=21801
#UL_MEDIA_BASE_URL=https://media.your-domain.example.com
# Domain for the media cookie. Blank derives the deepest domain the site host
# and media host share, which is right for a sibling subdomain. Set it only if
# the two are not related that way.
#UL_MEDIA_COOKIE_DOMAIN=
# Content-Security-Policy for media responses, minus frame-ancestors (added at
# runtime). Blank uses "default-src 'none'". Add `sandbox` if this deployment
# does not need in-browser document preview.
#UL_MEDIA_CSP=

# --- Sandbox tier -----------------------------------------------------------
# Whether a media-worker container is running to drain the `sandbox` queue.
# Set false ONLY where that container does not exist, otherwise uploads queue
# up with nothing to process them. Must be the same in every container: the
# process that enqueues a task is the one that stamps its queue.
#UL_SANDBOX_ENABLED=true
# What a non-sandbox process does when it is about to parse an upload:
#   warn  - log it and proceed (default; the log is the worklist)
#   deny  - raise. The target state, once nothing is logging warnings
#   allow - no check. The test suite's setting; do not use it in a deployment
#UL_UNTRUSTED_PARSE_POLICY=warn

# Database name - must match what docker-compose passes via UL_DB_NAME.
UL_DB_NAME=UrbanLensDB

# Database password. Change this before deploying.
UL_DB_PASS=changeme-train-usage-overdrive

# Get your Mapbox API token at https://account.mapbox.com
VITE_MAPBOX_API_TOKEN=

# Get your Google Client ID at https://console.developers.google.com/
UL_GOOGLE_CLIENT_ID=

# Get your Google Client Secret at https://console.developers.google.com/
UL_GOOGLE_CLIENT_SECRET=

# Get your Google Maps API Key at https://console.developers.google.com/
UL_GOOGLE_UNRESTRICTED_API_KEY=
UL_GOOGLE_DOMAIN_RESTRICTED_API_KEY=
UL_GOOGLE_PUBLIC_API_KEY=

# Configure your Google Custom Search Engine tenant at https://cse.google.com/cse/all
UL_GOOGLE_SEARCH_TENANT=

# Get your OpenWeatherMap API Key at https://home.openweathermap.org/users/sign_up
UL_OPENWEATHERMAP_API_KEY=


# REData (../REData) is the standalone service that provides county property-ownership/tax
# records. Generate an API key in its dashboard (or via manage.py) with at least the
# "parcels:read" scope.
UL_REDATA_API_URL=
UL_REDATA_API_KEY=

# Get your Twilio credentials at https://console.twilio.com/ - used for outbound SMS/WhatsApp notifications
UL_TWILIO_ACCOUNT_SID=
UL_TWILIO_AUTH_TOKEN=
UL_TWILIO_SMS_FROM_NUMBER=
UL_TWILIO_WHATSAPP_FROM_NUMBER=

# Configure your Cloudflare AI Endpoint in your Cloudflare dashboard
UL_CLOUDFLARE_AI_ENDPOINT=

# Get your Cloudflare AI API Key at https://dash.cloudflare.com/
UL_CLOUDFLARE_AI_API_KEY=

# Configure your Cloudflare Worker AI Endpoint in your Cloudflare dashboard
UL_CLOUDFLARE_WORKER_AI_ENDPOINT=


# Configure your Hugging Face AI Endpoint in your Hugging Face settings
UL_HUGGINGFACE_AI_ENDPOINT=

# Get your Hugging Face AI API Key at https://huggingface.co/settings/tokens
UL_HUGGINGFACE_AI_API_KEY=

# Get your OpenAI API Key at https://beta.openai.com/signup/
UL_OPENAI_API_KEY=

# Get your Anthropic (Claude) API Key at https://console.anthropic.com/settings/keys
UL_ANTHROPIC_API_KEY=

# Free, self-hosted local AI photo keywording via https://ollama.com/ - leave blank to disable
UL_OLLAMA_BASE_URL=
UL_OLLAMA_VISION_MODEL=llava

UL_APPLE_MAPS_API_KEY=

# Get your Azure Maps subscription key at https://portal.azure.com -> your Azure Maps account -> Authentication
UL_AZURE_MAPS_SUBSCRIPTION_KEY=

UL_USGS_API_KEY=
UL_USGS_USERNAME=

# SMTP (e.g. Smtp2Go)
UL_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
UL_EMAIL_HOST=smtp.gmail.com
UL_EMAIL_PORT=587
UL_EMAIL_TLS=True
UL_EMAIL_USE_SSL=False
UL_EMAIL_FROM=noreply@mydomain.org
UL_EMAIL_USER=
UL_EMAIL_PASSWORD=
# Database backups
# Scheduled backups are checked hourly; this controls whether they run.
#UL_BACKUP_ENABLED=True
# Minimum hours between scheduled backups. Site admins can override this in the UI.
#UL_BACKUP_FREQUENCY_HOURS=24
# Number of backup files to retain. Site admins can override this in the UI.
#UL_BACKUP_RETENTION=30
# Optional backup directory override (defaults to the app backups directory).
#UL_BACKUPS_DIR=backups

# Staging/deploy tooling (bin/clone_prod_to_staging.sh, bin/deploy.sh,
# bin/deploy_webhook.py, bin/staging_deploy.py) has moved to the separate
# `infrastructure` repo, which is not co-located with this checkout - it
# operates on this checkout by path (UL_STAGING_DIR) instead. See that repo's
# .env-sample and docs/OPS_TOOLING.md / docs/deployment.md for
# UL_PROD_DIR / UL_DEPLOY_WEBHOOK_* / UL_OPS_TOKEN, none of which are read by
# this application - they configure that repo's own processes.

# Additional env vars.
# Do not change these unless you know what you are doing.
# They are listed with their default values.
#UL_ALLOW_TEST_INTERNET=False

# When true, authenticated users WITHOUT site-admin permission can also see and use the
# developer toolbar (e.g. QA/test accounts). Only takes effect when UL_ENVIRONMENT (or the
# site admin's environment override) is local, development, or testing - ignored in
# staging/production regardless of this setting.
#UL_ALLOW_DEV_TOOLBAR_FOR_NON_ADMINS=False
# Root of a mirror of the third-party JS/CSS the site loads (Leaflet, toastr,
# htmx, Chart.js and the rest - the full list is VENDOR_ASSETS in
# dashboard/services/core/vendor_assets.py). Left blank, every one of them is
# fetched from its public CDN, which is the default and matches historical
# behaviour. Set, they are all fetched from here instead - decided when the page
# is rendered, so there is no per-request fallback and no failed request to wait
# on when a CDN is blocked or unreachable.
#
# The files themselves are deliberately not shipped in this repository: they are
# other projects' releases under their own licences. Mirror them wherever you
# like, keeping the paths in VENDOR_ASSETS (e.g. <root>/leaflet/1.9.4/leaflet.js).
#UL_VENDOR_ASSET_BASE_URL=https://assets.example.org/vendor
