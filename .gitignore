# Server state - Could contain sensitive details
*.log
.deploy.lock

# Compiled code
__pycache__/
*.pyc
/src/urbanlens/frontend/static/
**/frontend/static/admin/
**/frontend/static/**/*.css
**/frontend/static/**/*.css.map
**/frontend/static/*/js/
# Built from each package plugin's frontend/ sources.
/src/urbanlens/plugins/*/static/*/js/
/src/urbanlens/plugins/*/static/**/*.css
/src/urbanlens/plugins/*/static/**/*.css.map
src/urbanlens/media/
.codeql/
.sqlmap/
.ops-runs/

# Libraries (npm, etc)
node_modules
package-lock.json
# Except the integration suite's: npm is that project's package manager (the
# Playwright image carries npm and not bun), and with its transitives floating
# CI resolved a second playwright-core beside the one `playwright` bundles.
!tests/integration/package-lock.json
.venv/
.venv_windows/

