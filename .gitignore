# Server state - Could contain sensitive details
*.log
.deploy.lock

# Compiled code
__pycache__/
*.pyc
**/frontend/static/admin/
**/frontend/static/**/*.css
# ...and the source map sass:dev emits beside it. `*.css` above does not match
# `.css.map`, so it was tracked while the stylesheet it maps was not - every
# `bun run sass:dev` then dirtied a committed artifact for no benefit (the
# production `sass` script passes --no-source-map, so releases never have one).
**/frontend/static/**/*.css.map
# Bundled JS output (bin/build-frontend.ts writes <app>/frontend/static/<app>/js/).
# Hand-written JS not compiled from TS lives in frontend/static/js/ (no app segment) and stays tracked.
**/frontend/static/*/js/
src/urbanlens/frontend/static/dashboard/images/
src/urbanlens/frontend/static/icons/unused/
src/urbanlens/media/
docs/screenshots/

# Libraries (npm, etc)
node_modules
package-lock.json
.venv/
.venv_windows/

# Temporary files
*.out
*.tmp
*.swp
.*cache
sample_data/*.jpg
src/urbanlens/logs/*

# VSCode stuff per user (keep shared workspace config)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.favorites.json
.coverage
CLAUDE.local.md
.claude/*.json
.vscode/settings.json
.cursor/
docs/notes/ai/
docs/notes/geocoding-analysis/

# Secrets, authentication, etc
.env
bin/conf/
bin/settings.py
.pgpass

# Database files
*.sqlite3-journal
*db.sqlite3
pgsql
sample_data/Google Takeout.csv