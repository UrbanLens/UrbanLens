# Example production resource overrides, applied on top of docker-compose.yml's defaults.
#
# Copy into the production host's .env (or add to it), then recreate the app and db containers:
# a running container's CPU, memory and command are fixed at creation, so editing .env alone does
# nothing until the container is recreated.
#
# Sized for roughly 500 concurrent users on a host with 8 or more cores and 16GB or more of memory.
# Measure your own workload before relying on these numbers.
#
# test_production_app_cpu_allocation.py fails if the app tier drops to or below the shared default.

CPU_LIMIT__APP=8

# 12 workers x 4 gthread threads = 48 connections, which must stay under the web role's connection
# limit. test_connection_budget_wiring.py checks this against the role budget.
WEB_CONCURRENCY=12

# Each worker costs roughly 0.3GB. A worker recycling on --max-requests runs briefly alongside its
# replacement, so leave headroom above 12 workers' steady-state footprint.
MEM_LIMIT__APP=4g

# Postgres in production should run the tuned command from docker-compose.yml, not the stock
# `postgres` command, so that shared_buffers and random_page_cost pick up the values below.
CPU_LIMIT__DB=6
MEM_LIMIT__DB=4g

# The stock 128MB shared_buffers is smaller than the database. effective_cache_size follows the
# container's memory limit, because that is what bounds the page cache.
UL_DB_SHARED_BUFFERS=1GB
UL_DB_EFFECTIVE_CACHE_SIZE=3GB

# Primary Overpass endpoint that boundary lookups ask first. Production asks no public Overpass
# mirror by default, so leaving this unset makes every boundary lookup fail with OverpassUnavailableError.
UL_OVERPASS_API_URL=https://overpass.example.com/api/interpreter
