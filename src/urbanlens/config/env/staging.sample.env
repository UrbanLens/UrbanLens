# Staging resource limits: every value below the docker-compose.yml default.
#
# Staging and production share a host. Staging's containers were coming up on
# the file's own defaults, which for the web tier and the database are the
# highest weights in the file - so under contention staging outranked a
# production stack whose containers predate the cpu_shares keys entirely and
# therefore sit at the kernel's own default of 1024. See P114.
#
# Weights are capped at 512 rather than merely halved, for that reason: half of
# 2048 is 1024, which ties with a container that sets nothing rather than
# losing to it.
#
# Copy into staging's .env. Not an env_file - compose reads these while
# interpolating the file, which only the project directory's .env feeds.
#
# test_staging_limits_are_below_production.py fails if a variable
# docker-compose.yml reads is missing here, or is not below its default.

# Relative weight under contention - the half that decides who loses
CPU_SHARES__AI_INFERENCE=256
CPU_SHARES__AI_WORKER=64
CPU_SHARES__APP=512
CPU_SHARES__APP_WS=512
CPU_SHARES__CELERY_BEAT=128
CPU_SHARES__CELERY_METRICS=32
CPU_SHARES__CELERY_WORKER=128
CPU_SHARES__CELERY_WORKER_BULK=64
CPU_SHARES__CELERY_WORKER_PANELS=128
CPU_SHARES__CLAMAV=64
CPU_SHARES__DB=512
CPU_SHARES__EGRESS_PROXY=128
CPU_SHARES__MEDIA_NGINX=512
CPU_SHARES__MEDIA_WORKER=64
CPU_SHARES__MEDIA_WORKER_BATCH=32
CPU_SHARES__NGINX=512
CPU_SHARES__VALKEY=512

# Hard CPU ceilings
CPU_LIMIT__AI_INFERENCE=0.25
CPU_LIMIT__AI_WORKER=0.5
CPU_LIMIT__APP=1
CPU_LIMIT__APP_WS=0.5
CPU_LIMIT__CELERY_BEAT=0.25
CPU_LIMIT__CELERY_METRICS=0.25
CPU_LIMIT__CELERY_PANELS=0.5
CPU_LIMIT__CELERY_WORKER=1
CPU_LIMIT__CELERY_WORKER_BULK=0.5
CPU_LIMIT__CLAMAV=1
CPU_LIMIT__DB=1
CPU_LIMIT__EGRESS_PROXY=0.12
CPU_LIMIT__MEDIA_NGINX=1
CPU_LIMIT__MEDIA_WORKER=1
CPU_LIMIT__MEDIA_WORKER_BATCH=0.5
CPU_LIMIT__NGINX=1
CPU_LIMIT__VALKEY=0.5

# Memory ceilings
MEM_LIMIT__AI_INFERENCE=256m
MEM_LIMIT__AI_WORKER=512m
MEM_LIMIT__APP=1g
MEM_LIMIT__APP_WS=512m
MEM_LIMIT__CELERY_BEAT=256m
MEM_LIMIT__CELERY_METRICS=256m
MEM_LIMIT__CELERY_PANELS=512m
MEM_LIMIT__CELERY_WORKER=1536m
MEM_LIMIT__CELERY_WORKER_BULK=1536m
MEM_LIMIT__CLAMAV=1g
MEM_LIMIT__DB=1g
MEM_LIMIT__EGRESS_PROXY=64m
MEM_LIMIT__MEDIA_NGINX=64m
MEM_LIMIT__MEDIA_WORKER=1536m
MEM_LIMIT__MEDIA_WORKER_BATCH=1536m
MEM_LIMIT__NGINX=64m
MEM_LIMIT__VALKEY=512m
