# Provider API keys for the ai-inference container - and ONLY that container.
#
# Copy to `.env.ai` and fill in. Never put these in the root `.env`:
# `docker-compose.yml` gives `app` and `celery-worker` `env_file: .env`, which
# hands them every variable in it. A provider key placed there would sit in the
# same process environment as the database credentials and the field-encryption
# key - exactly the adjacency the ai-inference tier exists to break.
#
# `ai-inference` reads this file directly (`env_file: .env.ai`), so the keys
# never pass through compose's `${VAR}` interpolation and never need to exist
# in the root `.env` at all.
#
# The file is optional (`required: false`). Without it the stack still starts;
# ai-inference just answers every call with "No <provider> API key configured".
#
# Local dev without Docker is different and unaffected: `LocalInferenceClient`
# calls providers in-process and reads these from `AppSettings`, i.e. from the
# root `.env`. That is fine - a local checkout has no container boundary to
# protect. See docs/AI_PIPELINE.md.

# Anthropic - the assistant's tool loop is pinned to this provider.
UL_ANTHROPIC_API_KEY=

# OpenAI - text generation and vision (photo keywords) when
# SiteSettings.ai_provider is "openai".
UL_OPENAI_API_KEY=

# Cloudflare Workers AI - the low-cost text/vision provider, and the only
# source of the image classifier (ResNet-50) used for photo keywords.
UL_CLOUDFLARE_AI_API_KEY=
UL_CLOUDFLARE_WORKER_AI_ENDPOINT=
